## ============================================================
##  TVPlayer 本机配置 —— 复制为 local.properties 后填入实际值
##  此文件已被 .gitignore 排除，不会进入版本库
##  缺少此文件时 Gradle 仍可构建，但字幕 API 将以空 token 运行
## ============================================================

## ────────────────────────────────────────────────────────────
##  Android SDK
## ────────────────────────────────────────────────────────────
# Android SDK 绝对路径（Windows 下反斜杠用 \\ 转义，或改用正斜杠）
# 示例: D:\\Android\\Sdk  或  /opt/android-sdk
sdk.dir=

## ────────────────────────────────────────────────────────────
##  字幕站 API 凭证
##  这些值在编译时注入 BuildConfig，运行时由 Prefs.kt 读取。
##  留空 = 该字幕站功能不可用（搜索按钮灰显 / 自动跳过）。
## ────────────────────────────────────────────────────────────

# ┌─ Assrt 射手网 ─────────────────────────────────────────┐
# │  接口版本 : v1 (api.assrt.net)                          │
# │  申请地址 : https://secure.assrt.net  → 控制台 → API    │
# │  免费额度 : 个人用途通常足够，高频调用需联系站长提额      │
# │  注入字段 : BuildConfig.ASSRT_TOKEN                     │
# │  运行时键 : Prefs.assrtToken                            │
# └─────────────────────────────────────────────────────────┘
ASSRT_TOKEN=

# ┌─ OpenSubtitles ────────────────────────────────────────┐
# │  接口版本 : v1 (api.opensubtitles.com)                  │
# │  申请地址 : https://www.opensubtitles.com/zh/api        │
# │  免费额度 : 100 次/日（IP 限制），够用但别压测           │
# │  注入字段 : BuildConfig.OPENSUB_KEY                     │
# │  运行时键 : Prefs.openSubApiKey                         │
# └─────────────────────────────────────────────────────────┘
OPENSUB_KEY=

## ────────────────────────────────────────────────────────────
##  签名（可选，发布包才需要）
##  调试包走 Android 默认 debug.keystore，无需在此配置。
##  若需打 release 包，取消注释并填入实际值。
## ────────────────────────────────────────────────────────────
# STORE_FILE=keystore/release.jks
# STORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
