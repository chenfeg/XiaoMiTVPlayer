<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 只用 leanback 的控件类（VerticalGridView 等），主题锚 AppCompat 保证 AppCompatActivity 合法 -->
    <style name="Theme.TvPlayer" parent="Theme.AppCompat">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/bg</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Theme.TvPlayer.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
