<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="@dimen/page_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/assrt_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/settings_assrt_token"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/assrt_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_assrt_base"
            android:inputType="textUri"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/fakesub_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_fakesub_base"
            android:inputType="textUri"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <!--
            OpenSubtitles：搜索要 API key（官网免费申请），取正文要账号。
            电视上打字麻烦，所以留空=不启用，不填也不影响另外两个源。
        -->
        <EditText
            android:id="@+id/opensub_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_opensub_key"
            android:inputType="textVisiblePassword"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/opensub_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_opensub_user"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/opensub_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_opensub_pass"
            android:inputType="textPassword"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/opensub_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_opensub_base"
            android:inputType="textUri"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <CheckBox
            android:id="@+id/auto_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_auto_subtitle"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/subtitle_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_subtitle_size"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/subtitle_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_subtitle_delay"
            android:inputType="numberSigned"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <CheckBox
            android:id="@+id/audio_opensles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_audio_opensles"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:id="@+id/smb_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/smb_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/settings_smb_host"
                android:inputType="textUri"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <EditText
                android:id="@+id/smb_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_smb_share"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <EditText
                android:id="@+id/smb_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_smb_user"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <EditText
                android:id="@+id/smb_pass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_smb_pass"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_save" />

            <Button
                android:id="@+id/btn_clear_cache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/settings_cache_clear" />

            <Button
                android:id="@+id/btn_probe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/settings_probe" />

            <Button
                android:id="@+id/btn_beep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/settings_beep" />

            <Button
                android:id="@+id/btn_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/settings_log" />
        </LinearLayout>

        <TextView
            android:id="@+id/probe_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
