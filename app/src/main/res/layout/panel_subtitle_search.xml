<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页内的字幕搜索面板。刻意不做成独立 Activity：
    独立界面会销毁 SurfaceView 的 surface（返回时播放器没有画面），
    而且 PlayerActivity 在独立任务栈里被盖住后，返回键回来的经常不是播放页。
    面板盖在画面上，播放不中断，返回键只关面板。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="#F005070B"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subtitle_search_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitle_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" />

    <TextView
        android:id="@+id/search_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="12dp" />

    <ProgressBar
        android:id="@+id/loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/subtitle_panel_hint"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" />
</LinearLayout>
